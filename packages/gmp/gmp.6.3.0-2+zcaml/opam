opam-version: "2.0"
synopsis: "The GNU Multiple Precision Arithmetic Library, built by dune"
description: """
GMP 6.3.0's libgmp, compiled from the GNU tarball zig-gmp pins with the
context's C compiler and zig-gmp's generated sources, so it cross-compiles
without configure, make or m4. A library with no modules named gmp, as
ocaml-gmp's: it installs gmp.h and the static libgmp.a."""
maintainer: "Shreyas Mididoddi <me@shreyascodes.tech>"
authors: "Torbjörn Granlund and contributors"
license: ["LGPL-3.0-or-later" "GPL-2.0-or-later"]
homepage: "https://gmplib.org/"
bug-reports: "https://github.com/zcaml/zcaml/issues"
depends: [
  "ocaml"
  "dune" {>= "3.0"}
  "zig-gmp" {= "6.3.0"}
]
substs: [ "dune" "dune-project" ]
build: ["dune" "build" "-p" name "-j" jobs "@install"]
url {
  src: "https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.gz"
  checksum: [
    "sha256=e56fd59d76810932a0555aa15a14b61c16bed66110d3c75cc2ac49ddaa9ab24c"
    "sha512=44672c7568b007b4dffc5544374b9169004dfbe7ff79712302f15aa95d46229e3a057266a0421aadf95ab8a4af13ce4090d8ea39615d50c5064b4703a53fe3b0"
  ]
}
