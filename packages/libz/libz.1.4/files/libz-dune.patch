diff -ruN a/dune b/dune
--- a/dune	1970-01-01 05:30:00.000000000 +0530
+++ b/dune	2026-11-10 11:18:57.914169903 +0530
@@ -0,0 +1,34 @@
+; zlib, as a library with no modules: depending on it compiles C stubs
+; with its headers and links it.
+(foreign_library
+ (archive_name z)
+ (language c)
+ (names
+  adler32
+  compress
+  crc32
+  deflate
+  gzclose
+  gzlib
+  gzread
+  gzwrite
+  infback
+  inffast
+  inflate
+  inftrees
+  trees
+  uncompr
+  zutil)
+ (flags :standard -DHAVE_UNISTD_H=1 -DHAVE_STDARG_H=1))
+
+(library
+ (name libz_stubs)
+ (public_name libz)
+ (modules)
+ (foreign_archives z)
+ (install_c_headers zlib zconf))
+
+(install
+ (package libz)
+ (section lib)
+ (files (zlib.pc as pkgconfig/zlib.pc)))
diff -ruN a/dune-project b/dune-project
--- a/dune-project	1970-01-01 05:30:00.000000000 +0530
+++ b/dune-project	2026-11-10 11:18:57.914169903 +0530
@@ -0,0 +1,3 @@
+(lang dune 3.0)
+(name libz)
+(package (name libz) (allow_empty))
diff -ruN a/zlib.pc b/zlib.pc
--- a/zlib.pc	1970-01-01 05:30:00.000000000 +0530
+++ b/zlib.pc	2026-11-10 11:18:57.914169903 +0530
@@ -0,0 +1,10 @@
+prefix=${pcfiledir}/..
+exec_prefix=${prefix}
+libdir=${prefix}
+includedir=${prefix}
+
+Name: zlib
+Description: zlib 1.4 built from source by dune
+Version: 1.4
+Libs: -L${libdir} -lz
+Cflags: -I${includedir}
