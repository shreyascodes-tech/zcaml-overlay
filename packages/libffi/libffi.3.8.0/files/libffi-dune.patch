diff -ruN a/dune b/dune
--- a/dune	1970-01-01 05:30:00.000000000 +0530
+++ b/dune	2026-11-11 08:17:48.168260516 +0530
@@ -0,0 +1,104 @@
+; libffi, built from its C and assembly sources with the context's C compiler:
+; unlike conf-libffi, it cross-compiles. A library with no modules: depending
+; on it gives C stubs libffi's headers and links it.
+;
+; One library stanza per target, because configure would pick a different
+; source list and flags for each, and a library's foreign_archives can't
+; depend on the target. Each build/<architecture> directory copies the
+; portable sources and its architecture's own (with the assembly through
+; %{cc}); the stanzas there select the system's flags. ffi.h is a static
+; header (configure's substitutions are the target's own macros) and
+; ffitarget.h is copied from the target's architecture.
+
+(library
+ (name libffi)
+ (public_name libffi)
+ (modules)
+ (install_c_headers ffi ffitarget)
+ (enabled_if
+  (and
+   (= %{architecture} amd64)
+   (or (= %{system} linux) (= %{system} macosx))))
+ (foreign_archives build/amd64/ffi_stubs))
+
+(library
+ (name libffi)
+ (public_name libffi)
+ (modules)
+ (install_c_headers ffi ffitarget)
+ (enabled_if
+  (and
+   (= %{architecture} amd64)
+   (= %{system} mingw64)))
+ (foreign_archives build/amd64/ffi_stubs))
+
+(library
+ (name libffi)
+ (public_name libffi)
+ (modules)
+ (install_c_headers ffi ffitarget)
+ (enabled_if
+  (and
+   (= %{architecture} arm64)
+   (or (= %{system} linux) (= %{system} macosx))))
+ (foreign_archives build/arm64/ffi_stubs))
+
+(library
+ (name libffi)
+ (public_name libffi)
+ (modules)
+ (install_c_headers ffi ffitarget)
+ (enabled_if
+  (and
+   (= %{architecture} riscv)
+   (= %{system} linux)))
+ (foreign_archives build/riscv/ffi_stubs))
+
+(library
+ (name libffi)
+ (public_name libffi)
+ (modules)
+ (install_c_headers ffi ffitarget)
+ (enabled_if
+  (and
+   (= %{architecture} power)
+   (= %{system} linux)))
+ (foreign_archives build/powerpc/ffi_stubs))
+
+(library
+ (name libffi)
+ (public_name libffi)
+ (modules)
+ (install_c_headers ffi ffitarget)
+ (enabled_if
+  (and
+   (= %{architecture} s390x)
+   (= %{system} linux)))
+ (foreign_archives build/s390x/ffi_stubs))
+
+; configure copies the target's ffitarget.h to include/, and ffi.h includes
+; <ffitarget.h>.
+(rule
+ (targets ffitarget.h)
+ (enabled_if (= %{architecture} amd64))
+ (action (copy src/x86/ffitarget.h ffitarget.h)))
+
+(rule
+ (targets ffitarget.h)
+ (enabled_if (= %{architecture} arm64))
+ (action (copy src/aarch64/ffitarget.h ffitarget.h)))
+
+(rule
+ (targets ffitarget.h)
+ (enabled_if (= %{architecture} riscv))
+ (action (copy src/riscv/ffitarget.h ffitarget.h)))
+
+(rule
+ (targets ffitarget.h)
+ (enabled_if (= %{architecture} power))
+ (action (copy src/powerpc/ffitarget.h ffitarget.h)))
+
+(rule
+ (targets ffitarget.h)
+ (enabled_if (= %{architecture} s390x))
+ (action (copy src/s390/ffitarget.h ffitarget.h)))
