+; findlib generates META files for the compiler's own libraries into the
+; site-lib.  On OCaml 5 the only one it adds is the bytes compatibility
+; package; the others have their own META files in the standard library.
+(install
+ (package ocamlfind)
+ (section lib_root)
+ (files (bytes/META.in as bytes/META)))
diff -ruN a/src/findlib/META b/src/findlib/META
