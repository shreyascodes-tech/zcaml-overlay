diff -ruN a/META.ocamlbuild.template b/META.ocamlbuild.template
--- /dev/null
+++ b/META.ocamlbuild.template
@@ -0,0 +1,6 @@
+# Specification for the "ocamlbuild" library
+requires = "unix"
+version = "0.16.1"
+description = "ocamlbuild support library"
+archive(byte) = "ocamlbuildlib.cma plugin/ocamlbuild_plugin.cma"
+archive(native) = "ocamlbuildlib.cmxa plugin/ocamlbuild_plugin.cmxa"
diff -ruN a/bin/dune b/bin/dune
--- /dev/null
+++ b/bin/dune
@@ -0,0 +1,22 @@
+; The executable, and the module the plugin links after the plugin's own
+; module: ocamlbuild.cmo (upstream) runs Main.main, so the plugin's toplevel
+; side effects run first.
+(library
+ (name ocamlbuild_main)
+ (wrapped false)
+ (modules ocamlbuild_main)
+ (libraries ocamlbuild_pack unix)
+ (flags (:standard -w @14@29 -w +L -w +R -w +Z -strict-sequence)))
+
+(executable
+ (name ocamlbuild)
+ (public_name ocamlbuild)
+ (package ocamlbuild)
+ (modules ocamlbuild)
+ (libraries ocamlbuild_pack unix)
+ (flags (:standard -w @14@29 -w +L -w +R -w +Z -strict-sequence)))
+
+(install
+ (package ocamlbuild)
+ (section lib)
+ (files ocamlbuild_main.cma ocamlbuild_main.cmxa ocamlbuild_main.a))
diff -ruN a/bin/ocamlbuild_main.ml b/bin/ocamlbuild_main.ml
--- /dev/null
+++ b/bin/ocamlbuild_main.ml
@@ -0,0 +1,3 @@
+(* Linked into the plugin after myocamlbuild.ml, as upstream's ocamlbuild.cmo:
+   it starts the build once the plugin's toplevel code has run. *)
+let () = Ocamlbuild_pack.Main.main ()
diff -ruN a/dune-project b/dune-project
--- /dev/null
+++ b/dune-project
@@ -0,0 +1,3 @@
+(lang dune 3.0)
+(name ocamlbuild)
+(version 0.16.1)
diff -ruN a/plugin-lib/dune b/plugin-lib/dune
--- /dev/null
+++ b/plugin-lib/dune
@@ -0,0 +1,19 @@
+(library
+ (name ocamlbuild_plugin)
+ (public_name ocamlbuild.plugin)
+ (wrapped false)
+ (modules ocamlbuild_plugin ocamlbuild_unix_plugin)
+ (libraries ocamlbuild_pack unix)
+ (flags (:standard -w @14@29 -w +L -w +R -w +Z -strict-sequence)))
+
+; Upstream installed the plugin's modules beside ocamlbuildlib.cma, in the
+; package's top-level directory, so that findlib's -package ocamlbuild finds
+; them; dune installs its ocamlbuild.plugin subpackage under plugin/.
+(install
+ (package ocamlbuild)
+ (section lib)
+ (files
+  .ocamlbuild_plugin.objs/byte/ocamlbuild_plugin.cmi
+  .ocamlbuild_plugin.objs/byte/ocamlbuild_unix_plugin.cmi
+  .ocamlbuild_plugin.objs/native/ocamlbuild_plugin.cmx
+  .ocamlbuild_plugin.objs/native/ocamlbuild_unix_plugin.cmx))
diff -ruN a/src/dune b/src/dune
--- /dev/null
+++ b/src/dune
@@ -0,0 +1,43 @@
+; ocamlbuild's sources, as a wrapped library: its main module is
+; Ocamlbuild_pack, as upstream's pack was. Dune names the archive after the
+; library, so the install stanza below also installs upstream's
+; ocamlbuildlib.cma, which the META template and plugin builder refer to.
+(library
+ (name ocamlbuild_pack)
+ (public_name ocamlbuild)
+ (modules_without_implementation signatures)
+ (libraries unix)
+ (flags (:standard -w @14@29 -w +L -w +R -w +Z -strict-sequence)))
+
+(ocamllex glob_lexer lexers)
+
+; configure.make wrote ocamlbuild_config.ml from the compiler's configuration;
+; here dune's variables provide the same values.
+(rule
+ (targets ocamlbuild_config.ml)
+ (action
+  (with-stdout-to
+   %{targets}
+   (progn
+    (echo "(* generated by dune from the OCaml configuration *)\n")
+    (echo "let bindir = \"\"\n")
+    (echo "let libdir = \"\"\n")
+    (echo "let ocaml_libdir = {|%{ocaml_where}|}\n")
+    (echo "let libdir_abs = {|%{ocaml_where}|}\n")
+    (echo "let ocaml_native = true\n")
+    (echo "let ocaml_native_tools = true\n")
+    (echo "let supports_shared_libraries = true\n")
+    (echo "let a = \"a\"\n")
+    (echo "let o = \"o\"\n")
+    (echo "let so = \"so\"\n")
+    (echo "let ext_dll = \"%{ocaml-config:ext_dll}\"\n")
+    (echo "let exe = \"%{ocaml-config:ext_exe}\"\n")
+    (echo "let version = \"0.16.1\"\n")))))
+
+(install
+ (package ocamlbuild)
+ (section lib)
+ (files
+  (ocamlbuild_pack.cma as ocamlbuildlib.cma)
+  (ocamlbuild_pack.cmxa as ocamlbuildlib.cmxa)
+  (ocamlbuild_pack.a as ocamlbuildlib.a)))
