+typedef struct {
+#if FFI_H_EXEC_TRAMPOLINE_TABLE
+  void *trampoline_table;
+  void *trampoline_table_entry;
+#else
+  char tramp[FFI_TRAMPOLINE_SIZE];
+#endif
