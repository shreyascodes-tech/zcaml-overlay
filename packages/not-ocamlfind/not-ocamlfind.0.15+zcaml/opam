opam-version: "2.0"
synopsis: "A small frontend for ocamlfind that adds a few useful commands"
license: "MIT"
x-maintenance-intent: [ "(latest)" ]
maintainer: "Chet Murthy <chetsky@gmail.com>"
authors: "Chet Murthy <chetsky@gmail.com>"
homepage: "https://github.com/chetmurthy/not-ocamlfind"
bug-reports: "Chet Murthy <chetsky@gmail.com>"
description: """
Built with dune: upstream's Makefile runs ocamlfind to build and install;
the dune port links findlib's library and execs the ocamlfind tool, which it
needs at run time."""
depends: [
  "ocaml"
  "dune" {>= "3.0"}
  "ocamlfind" {>= "1.9.6"}
  "camlp-streams"
  "fmt" {>= "0.8.8"}
  "rresult" {>= "0.6.0"}
  "ocamlgraph" {>= "2.0.0"}
]
depexts: [
  [
    "xdot"
  ] {os-family = "debian"}
]
patches: ["not-ocamlfind-dune.patch"]
build: [["dune" "build" "-p" name "-j" jobs "@install"]]
dev-repo: "git+https://github.com/chetmurthy/not-ocamlfind"
url {
  src: "https://github.com/chetmurthy/not-ocamlfind/archive/refs/tags/0.15.tar.gz"
