diff -ruN a/src/files/ocsigenserver.conf/gen_options.ml b/src/files/ocsigenserver.conf/gen_options.ml
--- a/src/files/ocsigenserver.conf/gen_options.ml	1970-01-01 05:30:00.000000000 +0530
+++ b/src/files/ocsigenserver.conf/gen_options.ml	2026-11-11 12:06:43.869451377 +0530
@@ -0,0 +1,37 @@
+(* Generates options.ml, which configure used to write: the paths are the
+   package's install paths, which dune gives us. *)
+
+let absolute path =
+  if Filename.is_relative path then Filename.concat (Sys.getcwd ()) path
+  else path
+
+let ( // ) = Filename.concat
+
+let () =
+  let destdir = Sys.argv.(1) in
+  let meta = absolute Sys.argv.(2) in
+  let version = String.trim Sys.argv.(3) in
+  (* dune pkg's OCAMLFIND_DESTDIR is <prefix>/lib; without it,
+     <prefix>/lib/ocsigenserver/META has two dirnames up at <prefix>/lib. *)
+  let libdir =
+    if destdir = "" then Filename.dirname (Filename.dirname meta)
+    else absolute destdir
+  in
+  let prefix = Filename.dirname libdir in
+  let ocsigen = libdir // "ocsigenserver" in
+  let configdir = ocsigen // "etc" // "ocsigenserver" in
+  Printf.printf "let version = %S\n" version;
+  Printf.printf "let src = \"\"\n";
+  Printf.printf "let port = 80\n";
+  Printf.printf "let bindir = %S\n" (prefix // "bin");
+  Printf.printf "let libdir = %S\n" libdir;
+  Printf.printf "let libdir_set = 1\n";
+  Printf.printf "let logdir = %S\n" (ocsigen // "var" // "log" // "ocsigenserver");
+  Printf.printf "let configdir = %S\n" configdir;
+  Printf.printf "let staticpagesdir = %S\n" (ocsigen // "var" // "www");
+  Printf.printf "let datadir = %S\n" (ocsigen // "var" // "lib" // "ocsigenserver");
+  Printf.printf "let uploaddir = %S\n" "/tmp";
+  Printf.printf
+    "let commandpipe = %S\n"
+    (ocsigen // "var" // "run" // "ocsigenserver_command");
+  Printf.printf "let mimefile = %S\n" (configdir // "mime.types")
