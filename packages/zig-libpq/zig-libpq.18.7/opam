opam-version: "2.0"
synopsis: "libpq 18.7's generated sources, from zig-libpq"
description: """
zig-libpq's checked-in generated headers and manifest for libpq, the
PostgreSQL 18.7 client library, installed for libpq to build from. The
manifest is plain text: it lists the sources, flags and include directories
per platform, so neither meson, ninja nor perl is needed."""
maintainer: "Shreyas Mididoddi <me@shreyascodes.tech>"
authors: ["zig-libpq contributors"]
license: "PostgreSQL"
homepage: "https://github.com/shreyassanthu77/zig-libpq"
bug-reports: "https://github.com/shreyascodes-tech/zcaml-overlay/issues"
depends: [
  "ocaml"
  "dune" {>= "3.0"}
]
substs: [ "dune" "dune-project" ]
build: ["dune" "build" "-p" name "-j" jobs "@install"]
