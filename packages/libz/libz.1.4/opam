opam-version: "2.0"
synopsis: "zlib, built from source by dune"
description: """
zlib's C library, compiled with the context's C compiler: unlike conf-zlib,
which needs it installed on the system, it cross-compiles. A library with no
modules: depending on it gives C stubs zlib's headers and links it, and its
zlib.pc lets conf-zlib answer pkg-config queries."""
maintainer: "Shreyas Mididoddi <me@shreyascodes.tech>"
authors: ["Jean-loup Gailly" "Mark Adler"]
license: "Zlib"
homepage: "https://zlib.net"
bug-reports: "https://github.com/zcaml/zcaml/issues"
depends: [
  "ocaml"
  "dune" {>= "3.0"}
]
patches: [ "libz-dune.patch" ]
build: ["dune" "build" "-p" name "-j" jobs]
url {
  src: "https://github.com/madler/zlib/releases/download/v1.4/zlib-1.4.tar.gz"
  checksum: [
    "sha256=02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584"
    "sha512=13f02285da85956ff722d814695b96807aff7a511ebf4b6d98cf708c353920666093cc18b6653cd7992c8e75c103f7b4baf2de3a105c2db9dcd62bab2c940859"
  ]
}
