opam-version: "2.0"
synopsis: "libogg, built from source by dune"
description: """
libogg's C library, compiled with the context's C compiler: unlike
conf-libogg, which needs it installed on the system, it cross-compiles. A
library with no modules: depending on it gives C stubs ogg's headers and
links it. The headers keep their <ogg/...> names."""
maintainer: "Shreyas Mididoddi <me@shreyascodes.tech>"
authors: ["Xiph.Org Foundation"]
license: "BSD-3-Clause"
homepage: "https://xiph.org/ogg/"
bug-reports: "https://github.com/shreyascodes-tech/zcaml-overlay/issues"
depends: [
  "ocaml"
  "dune" {>= "3.0"}
]
patches: [ "libogg-dune.patch" ]
build: ["dune" "build" "-p" name "-j" jobs]
url {
  src: "https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.gz"
  checksum: [
    "sha256=0eb4b4b9420a0f51db142ba3f9c64b333f826532dc0f48c6410ae51f4799b664"
