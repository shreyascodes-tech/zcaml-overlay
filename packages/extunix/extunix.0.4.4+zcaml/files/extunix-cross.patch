diff -ruN a/ppx_have/ppx_have.ml b/ppx_have/ppx_have.ml
--- a/ppx_have/ppx_have.ml	2026-11-08 22:49:32.554294815 +0530
+++ b/ppx_have/ppx_have.ml	2026-11-08 22:49:32.575539810 +0530
@@ -1,16 +1,26 @@
 let all = ref false
 let funcs = Hashtbl.create 16
+let features = Hashtbl.create 64
+
+let read_features file =
+  let ch = open_in file in
+  (try
+     while true do
+       Scanf.sscanf (input_line ch) "%s %B" (Hashtbl.replace features)
+     done
+   with End_of_file -> ());
+  close_in ch
 
 let args_spec =
   [
     ("--gen-all", Arg.Set all, "generate values from all [%%have ...] sections");
+    ("--features", Arg.String read_features, "<file> the features discover found");
   ]
 
-module ExtUnixConfig = Config
 open Ppxlib
 
 let check ~loc name =
-  match ExtUnixConfig.feature name with
+  match Hashtbl.find_opt features name with
   | None -> Location.raise_errorf ~loc "Unregistered feature %s" name
   | Some have -> have
 
