#!/bin/sh
# pkg-config for libopenssl, without needing pkg-config installed.
#
# conf-libssl exports PKG_CONFIG=pkg-config-zcaml, which dune-configurator
# runs. libopenssl is a sibling package build, so find its OpenSSL there and
# answer the queries dune-configurator makes from its .pc file.
set -u

self=$0
case $self in
  */*) ;;
  *) self=$(command -v -- "$self") || exit 127 ;;
esac
bindir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd) || exit 1
# <...>/.pkg/conf-libssl.<version>-<hash>/target/bin -> <...>/.pkg
root=$(dirname -- "$(dirname -- "$(dirname -- "$bindir")")")

pc=
for dir in "$root"/libopenssl.*/target/lib/libopenssl/pkgconfig; do
  if [ -f "$dir/openssl.pc" ]; then
    pc=$dir/openssl.pc
    break
  fi
done
if [ -z "$pc" ]; then
  old_ifs=$IFS
  IFS=:
  for dir in ${OCAMLPATH-}; do
    if [ -f "$dir/libopenssl/pkgconfig/openssl.pc" ]; then
      pc=$dir/libopenssl/pkgconfig/openssl.pc
      break
    fi
  done
  IFS=$old_ifs
fi
if [ -z "$pc" ]; then
  echo "pkg-config-zcaml: libopenssl's openssl.pc not found" >&2
  exit 1
fi

pcdir=$(CDPATH= cd -- "$(dirname -- "$pc")" && pwd) || exit 1
prefix=$(CDPATH= cd -- "$pcdir/.." && pwd) || exit 1
libdir=$prefix
includedir=$prefix
libs=$(sed -n 's/^Libs:[[:space:]]*//p' "$pc" | head -n 1)
cflags=$(sed -n 's/^Cflags:[[:space:]]*//p' "$pc" | head -n 1)

expand() {
  printf '%s\n' "$1" | sed \
    -e "s|\${pcfiledir}|$pcdir|g" \
    -e "s|\${prefix}|$prefix|g" \
    -e "s|\${exec_prefix}|$prefix|g" \
    -e "s|\${libdir}|$libdir|g" \
    -e "s|\${includedir}|$includedir|g"
}

libs=$(expand "$libs")
cflags=$(expand "$cflags")

mode=
variable=
package=
version_op=
version=
for arg in "$@"; do
  case $arg in
    --print-errors | --silence-errors | --short-errors | --static) ;;
    --exists) mode=exists ;;
    --libs) mode=libs ;;
    --cflags) mode=cflags ;;
    --modversion) mode=modversion ;;
    --version) mode=version ;;
    --libs-only-l) mode=libs_only_l ;;
    --libs-only-L) mode=libs_only_L ;;
    --cflags-only-I) mode=cflags_only_I ;;
    --variable=*) mode=variable; variable=${arg#--variable=} ;;
    --atleast-version=*) mode=version_check; version_op=atleast; version=${arg#*=} ;;
    --exact-version=*) mode=version_check; version_op=exact; version=${arg#*=} ;;
    --max-version=*) mode=version_check; version_op=max; version=${arg#*=} ;;
    --*) ;;
    *) package=$arg ;;
  esac
done

case $package in
  openssl | libssl | libcrypto) ;;
  *) exit 1 ;;
esac

case $mode in
  exists | '') exit 0 ;;
  libs) printf '%s\n' "$libs" ;;
  libs_only_l) printf '%s\n' "$libs" | tr ' ' '\n' | sed -n '/^-l/p' | tr '\n' ' ' | sed 's/ $//' ;;
  libs_only_L) printf '%s\n' "$libs" | tr ' ' '\n' | sed -n '/^-L/p' | tr '\n' ' ' | sed 's/ $//' ;;
  cflags) printf '%s\n' "$cflags" ;;
  cflags_only_I) printf '%s\n' "$cflags" | tr ' ' '\n' | sed -n '/^-I/p' | tr '\n' ' ' | sed 's/ $//' ;;
  modversion) printf '4.1.0\n' ;;
  version) printf '4.1.0\n' ;;
  version_check)
    cmp=$(awk -v a=4.1.0 -v b="$version" '
      BEGIN {
        na = split(a, aa, "."); nb = split(b, bb, ".")
        for (i = 1; i <= 3; i++) {
          x = (i <= na ? aa[i] : 0) + 0
          y = (i <= nb ? bb[i] : 0) + 0
          if (x < y) { print -1; exit }
          if (x > y) { print 1; exit }
        }
        print 0
      }')
    case $version_op in
      atleast) [ "$cmp" -ge 0 ] ;;
      exact) [ "$cmp" -eq 0 ] ;;
      max) [ "$cmp" -le 0 ] ;;
      *) exit 1 ;;
    esac
    ;;
  variable)
    case $variable in
      prefix) printf '%s\n' "$prefix" ;;
      exec_prefix) printf '%s\n' "$prefix" ;;
      libdir) printf '%s\n' "$libdir" ;;
      includedir) printf '%s\n' "$includedir" ;;
      version) printf '4.1.0\n' ;;
      *) exit 1 ;;
    esac
    ;;
  *) exit 1 ;;
esac
