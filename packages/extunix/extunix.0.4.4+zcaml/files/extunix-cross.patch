--- a/discover/discover.ml	2026-11-08 22:49:32.554171502 +0530
+++ b/discover/discover.ml	2026-11-08 22:49:32.575082646 +0530
@@ -191,6 +191,15 @@
   | NO name -> pr "| `%s -> false" name) result;
   close_out ch
 
+(* For ppx_have, which runs on the build machine: not config.ml, which it would be
+   built with in the build machine's context. *)
+let show_features file result =
+  let ch = open_out file in
+  List.iter (function
+  | YES {name; _} -> Printf.fprintf ch "%s true\n" name
+  | NO name -> Printf.fprintf ch "%s false\n" name) result;
+  close_out ch
+
 let show_c_flags_sexp file c =
   let cflags =
     match C.ocaml_config_var c "ccomp_type" with
@@ -216,6 +225,7 @@
   let result = List.map (discover c) config in
   show_c "config.h" result;
   show_ml "config.ml" result;
+  show_features "features" result;
   show_c_flags_sexp "c_flags.sexp" c;
   show_link_flags_sexp "link_flags.sexp" result
 
