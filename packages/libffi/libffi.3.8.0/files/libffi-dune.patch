diff -ruN a/build.sh b/build.sh
--- a/build.sh	1970-01-01 05:30:00.000000000 +0530
+++ b/build.sh	2026-11-09 13:41:43.961703616 +0530
@@ -0,0 +1,132 @@
+#!/bin/sh
+# Builds libffi's static library and headers with the context's C compiler, as
+# libffi's configure would, but without autotools: the sources are a fixed list
+# per target, and fficonfig.h is a static header.
+#
+#   build.sh <cc> <system> <architecture>
+#
+# <system> and <architecture> are dune's %{system} and %{architecture}, for the
+# OCaml target: linux, macosx, mingw64; amd64, arm64, riscv, power, s390x.
+set -eu
+
+cc="$1"
+system="$2"
+arch="$3"
+
+case "$system:$arch" in
+  linux:amd64)
+    targetdir=x86
+    target=X86_64
+    archsrc="src/x86/ffi64.c src/x86/ffiw64.c"
+    archasm="src/x86/unix64.S src/x86/win64.S"
+    ;;
+  linux:arm64)
+    targetdir=aarch64
+    target=AARCH64
+    archsrc="src/aarch64/ffi.c"
+    archasm="src/aarch64/sysv.S"
+    ;;
+  linux:riscv)
+    targetdir=riscv
+    target=RISCV
+    archsrc="src/riscv/ffi.c"
+    archasm="src/riscv/sysv.S"
+    ;;
+  linux:power)
+    targetdir=powerpc
+    target=POWERPC
+    archsrc="src/powerpc/ffi.c src/powerpc/ffi_sysv.c src/powerpc/ffi_linux64.c"
+    archasm="src/powerpc/sysv.S src/powerpc/ppc_closure.S src/powerpc/linux64.S src/powerpc/linux64_closure.S"
+    ;;
+  linux:s390x)
+    targetdir=s390
+    target=S390
+    archsrc="src/s390/ffi.c"
+    archasm="src/s390/sysv.S"
+    ;;
+  macosx:amd64)
+    targetdir=x86
+    target=X86_64
+    archsrc="src/x86/ffi64.c src/x86/ffiw64.c"
+    archasm="src/x86/unix64.S src/x86/win64.S"
+    ;;
+  macosx:arm64)
+    targetdir=aarch64
+    target=AARCH64
+    archsrc="src/aarch64/ffi.c"
+    archasm="src/aarch64/sysv.S"
+    ;;
+  mingw64:amd64)
+    targetdir=x86
+    target=X86_WIN64
+    archsrc="src/x86/ffiw64.c"
+    archasm="src/x86/win64.S"
+    ;;
+  *)
+    echo "libffi: no build for $system/$arch" >&2
+    exit 1
+    ;;
+esac
+
+case "$system" in
+  linux | macosx)
+    common_flags="-pthread -D_FILE_OFFSET_BITS=64"
+    ;;
+  mingw64)
+    common_flags="-mms-bitfields"
+    ;;
+esac
+
+# The objects also become a shared library, for bytecode and dynlink.
+case "$system" in
+  linux | macosx) common_flags="$common_flags -fPIC" ;;
+esac
+case "$system:$arch" in
+  linux:power) common_flags="$common_flags -mabi=ibmlongdouble" ;;
+esac
+
+# ffi.h: include/ffi.h.in's substitutions. HAVE_LONG_DOUBLE and
+# FFI_EXEC_TRAMPOLINE_TABLE are the two that vary by target.
+case "$system:$arch" in
+  macosx:arm64) long_double=0; trampoline_table=1 ;;
+  *) long_double=1; trampoline_table=0 ;;
+esac
+sed \
+  -e "s/@VERSION@/3.8.0/g" \
+  -e "s/@TARGET@/$target/g" \
+  -e "s/@HAVE_LONG_DOUBLE@/$long_double/g" \
+  -e "s/@FFI_VERSION_STRING@/3.8.0/g" \
+  -e "s/@FFI_VERSION_NUMBER@/30800/g" \
+  -e "s/@FFI_EXEC_TRAMPOLINE_TABLE@/$trampoline_table/g" \
+  include/ffi.h.in >ffi.h
+cp "src/$targetdir/ffitarget.h" ffitarget.h
+
+objdir=.libffi-build/obj
+rm -rf .libffi-build
+mkdir -p "$objdir"
+
+common="src/prep_cif.c src/types.c src/raw_api.c src/java_raw_api.c src/closures.c src/tramp.c"
+flags="-O3 -fexceptions -fno-sanitize=undefined $common_flags -Iinclude -I. -Isrc -Isrc/$targetdir"
+for f in $common $archsrc; do
+  "$cc" $flags -c "$f" -o "$objdir/$(basename "$f" .c).o"
+done
+for f in $archasm; do
+  "$cc" $flags -c "$f" -o "$objdir/$(basename "$f" .S).o"
+done
+
+# The toolchain's archiver, or the one $AR names (which may carry flags).
+ar=${AR:-ar}
+$ar cr libffi_stubs.a "$objdir"/*.o
+
+# Dune's foreign_archives wants dllffi_stubs.so on Unix, .dll on Windows.
+# Produce both names: each build only uses its own.
+case "$system" in
+  linux) "$cc" $common_flags -shared -o dllffi_stubs.so "$objdir"/*.o ;;
+  macosx) "$cc" $common_flags -dynamiclib -o dllffi_stubs.so "$objdir"/*.o ;;
+  mingw64)
+    "$cc" $common_flags -shared -o dllffi_stubs.dll "$objdir"/*.o \
+      -Wl,--export-all-symbols
+    ;;
+esac
+[ -f dllffi_stubs.so ] || cp dllffi_stubs.dll dllffi_stubs.so
+[ -f dllffi_stubs.dll ] || cp dllffi_stubs.so dllffi_stubs.dll
diff -ruN a/dune b/dune
--- a/dune	1970-01-01 05:30:00.000000000 +0530
+++ b/dune	2026-11-09 13:29:06.118913407 +0530
@@ -0,0 +1,24 @@
+; libffi, built from its C and assembly sources with the context's C compiler:
+; unlike conf-libffi, it cross-compiles. A library with no modules: depending
+; on it gives C stubs libffi's headers and links it.
+(rule
+ (targets libffi_stubs.a dllffi_stubs.so dllffi_stubs.dll ffi.h ffitarget.h)
+ (deps
+  (source_tree src)
+  (source_tree include)
+  build.sh
+  fficonfig.h)
+ (action
+  (run
+   sh
+   build.sh
+   %{ocaml-config:c_compiler}
+   %{system}
+   %{architecture})))
+
+(library
+ (name libffi)
+ (public_name libffi)
+ (modules)
+ (foreign_archives ffi_stubs)
+ (install_c_headers ffi ffitarget))
diff -ruN a/dune-project b/dune-project
--- a/dune-project	1970-01-01 05:30:00.000000000 +0530
+++ b/dune-project	2026-11-09 13:25:49.870498706 +0530
@@ -0,0 +1,5 @@
+(lang dune 3.0)
+(name libffi)
+(package
+ (name libffi)
+ (allow_empty))
diff -ruN a/fficonfig.h b/fficonfig.h
--- a/fficonfig.h	1970-01-01 05:30:00.000000000 +0530
+++ b/fficonfig.h	2026-11-09 13:28:59.797436388 +0530
@@ -0,0 +1,95 @@
+/* fficonfig.h for zcaml: what libffi's configure would define, without
+   configure. The differences between targets are all compiler-visible. */
+#ifndef ZCAML_FFICONFIG_H
+#define ZCAML_FFICONFIG_H
+
+#define EH_FRAME_FLAGS "a"
+
+#define HAVE_INT128 1
+#define HAVE_INTTYPES_H 1
+#define HAVE_MEMCPY 1
+#define HAVE_RO_EH_FRAME 1
+#define HAVE_STDINT_H 1
+#define HAVE_STDIO_H 1
+#define HAVE_STDLIB_H 1
+#define HAVE_STRINGS_H 1
+#define HAVE_STRING_H 1
+#define HAVE_SYS_STAT_H 1
+#define HAVE_SYS_TYPES_H 1
+#define HAVE_UNISTD_H 1
+
+#define LT_OBJDIR ".libs/"
+#define PACKAGE "libffi"
+#define PACKAGE_BUGREPORT "http://github.com/libffi/libffi/issues"
+#define PACKAGE_NAME "libffi"
+#define PACKAGE_STRING "libffi 3.8.0"
+#define PACKAGE_TARNAME "libffi"
+#define PACKAGE_URL ""
+#define PACKAGE_VERSION "3.8.0"
+#define SIZEOF_DOUBLE __SIZEOF_DOUBLE__
+#define SIZEOF_LONG_DOUBLE __SIZEOF_LONG_DOUBLE__
+#define SIZEOF_SIZE_T __SIZEOF_SIZE_T__
+#define STDC_HEADERS 1
+#define VERSION "3.8.0"
+
+#if defined(__linux__)
+# define FFI_EXEC_STATIC_TRAMP 1
+# define HAVE_ALLOCA_H 1
+# define HAVE_AS_CFI_PSEUDO_OP 1
+# define HAVE_DLFCN_H 1
+# define HAVE_MEMFD_CREATE 1
+#endif
+
+#if defined(__APPLE__)
+# define HAVE_ALLOCA_H 1
+# define HAVE_AS_CFI_PSEUDO_OP 1
+# define HAVE_DLFCN_H 1
+#endif
+
+#if !defined(_WIN32)
+# define HAVE_HIDDEN_VISIBILITY_ATTRIBUTE 1
+#endif
+
+#if defined(__x86_64__)
+# define HAVE_AS_X86_PCREL 1
+#endif
+
+#if defined(__linux__) && defined(__x86_64__)
+# define HAVE_AS_X86_64_UNWIND_SECTION_TYPE 1
+#endif
+
+#if defined(__APPLE__) && defined(__x86_64__)
+# define FFI_MMAP_EXEC_WRIT 1
+#endif
+
+#if defined(__APPLE__) && defined(__aarch64__)
+# define FFI_EXEC_TRAMPOLINE_TABLE 1
+#elif defined(__powerpc64__) || defined(__powerpc64le__)
+# define HAVE_LONG_DOUBLE_VARIANT 1
+#else
+# define HAVE_LONG_DOUBLE 1
+#endif
+
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+# define WORDS_BIGENDIAN 1
+#endif
+
+#ifdef HAVE_HIDDEN_VISIBILITY_ATTRIBUTE
+#ifdef LIBFFI_ASM
+#ifdef __APPLE__
+#define FFI_HIDDEN(name) .private_extern name
+#else
+#define FFI_HIDDEN(name) .hidden name
+#endif
+#else
+#define FFI_HIDDEN __attribute__ ((visibility ("hidden")))
+#endif
+#else
+#ifdef LIBFFI_ASM
+#define FFI_HIDDEN(name)
+#else
+#define FFI_HIDDEN
+#endif
+#endif
+
+#endif
