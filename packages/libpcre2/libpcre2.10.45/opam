opam-version: "2.0"
synopsis: "PCRE2, built from source by dune"
description: """
PCRE2's 8-bit C library, compiled with the context's C compiler: unlike
conf-libpcre2-8, which needs it installed on the system, it cross-compiles. A
library with no modules: depending on it gives C stubs pcre2.h and links it.
JIT is off: it needs executable memory, which a cross target may not have."""
maintainer: "Shreyas Mididoddi <me@shreyascodes.tech>"
authors: ["Philip Hazel" "Zoltan Herczeg"]
license: "BSD-3-Clause"
homepage: "https://www.pcre.org/"
bug-reports: "https://github.com/shreyascodes-tech/zcaml-overlay/issues"
depends: [
  "ocaml"
  "dune" {>= "3.0"}
]
patches: [ "libpcre2-dune.patch" ]
build: ["dune" "build" "-p" name "-j" jobs]
url {
  src: "https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.45/pcre2-10.45.tar.gz"
  checksum: [
    "sha256=0e138387df7835d7403b8351e2226c1377da804e0737db0e071b48f07c9d12ee"
    "sha512=6ec01a05ce65be61e5974dcc2ccd2e2b5c6db183e3a592530205c7d3259b730df3a9ab999d204f3c52e5a14ae88f32f94306b4501eb9629568ce6158985e2fa6"
  ]
}
