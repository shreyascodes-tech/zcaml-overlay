diff -ruN a/tools/gen/gen.ml b/tools/gen/gen.ml
--- a/tools/gen/gen.ml	1970-01-01 05:30:00.000000000 +0530
+++ b/tools/gen/gen.ml	2026-11-10 11:58:07.595190917 +0530
@@ -0,0 +1,94 @@
+(* Generates the files that findlib's configure and make used sed for:
+   findlib_config.ml (from findlib_config.mlp), the topfind script (from
+   topfind.in), and findlib.conf. *)
+
+let read_file path =
+  let ch = open_in_bin path in
+  let n = in_channel_length ch in
+  let s = really_input_string ch n in
+  close_in ch;
+  s
+
+let write_file path s =
+  let ch = open_out_bin path in
+  output_string ch s;
+  close_out ch
+
+let replace_all ~sub ~by s =
+  let n = String.length sub in
+  let b = Buffer.create (String.length s) in
+  let rec loop i =
+    if i + n > String.length s then Buffer.add_substring b s i (String.length s - i)
+    else if String.sub s i n = sub then (Buffer.add_string b by; loop (i + n))
+    else (Buffer.add_char b s.[i]; loop (i + 1))
+  in
+  loop 0;
+  Buffer.contents b
+
+let strip_prefix p s =
+  let n = String.length p in
+  if String.length s >= n && String.sub s 0 n = p
+  then Some (String.sub s n (String.length s - n))
+  else None
+
+(* The findlib prefix is where lib/findlib.conf is installed: $FINDLIB_PREFIX
+   when the build sets it, otherwise the compiler's own library directory. *)
+let prefix default =
+  match Sys.getenv_opt "FINDLIB_PREFIX" with
+  | Some p -> p
+  | None -> default
+
+let substitute vars s =
+  List.fold_left (fun s (sub, by) -> replace_all ~sub ~by s) s vars
+
+(* findlib_config.mlp has two variants per line, `ax:` for the normal build
+   and `rx:` for a relocatable one; findlib's make keeps the `ax:` lines. *)
+let gen_config mlp out stdlib system =
+  let stdlib_esc = String.escaped stdlib in
+  let config_esc = String.escaped (Filename.concat (prefix stdlib) "findlib.conf") in
+  let vars =
+    [ ("@CONFIGFILE@", config_esc)
+    ; ("@CONFIGFILENAME@", "findlib.conf")
+    ; ("@STDLIB@", stdlib_esc)
+    ; ("@RELATIVE_PATHS@", "false")
+    ; ("@AUTOLINK@", "true")
+    ; ("@SYSTEM@", String.escaped system)
+    ; ("@CONFIG_FROM_STDLIB@", "")
+    ]
+  in
+  let body =
+    String.split_on_char '\n' (read_file mlp)
+    |> List.filter_map (fun line ->
+      if strip_prefix "rx:" line <> None then None
+      else Some (match strip_prefix "ax:" line with Some l -> l | None -> line))
+    |> String.concat "\n"
+  in
+  write_file out (substitute vars body)
+
+let gen_topfind inp out default =
+  let vars =
+    [ ("@SITELIB@", String.escaped (prefix default)); ("@RELATIVE_PATHS@", "false") ]
+  in
+  let body =
+    String.split_on_char '\n' (read_file inp)
+    |> List.filter_map (fun line ->
+      if strip_prefix "rx:" line <> None then None
+      else Some (match strip_prefix "4x:" line with Some l -> l | None -> line))
+    |> String.concat "\n"
+  in
+  write_file out (substitute vars body)
+
+let gen_conf out default =
+  let p = prefix default in
+  write_file out (Printf.sprintf "destdir=%S\npath=%S\n" p p)
+
+let () =
+  match Array.to_list Sys.argv with
+  | _ :: "config" :: mlp :: out :: stdlib :: system :: _ ->
+      gen_config mlp out stdlib system
+  | _ :: "topfind" :: inp :: out :: sitelib :: _ -> gen_topfind inp out sitelib
+  | _ :: "conf" :: out :: default :: _ -> gen_conf out default
+  | _ ->
+      prerr_endline
+        "usage: gen config|topfind|conf <input...> <output> [args]";
+      exit 2
