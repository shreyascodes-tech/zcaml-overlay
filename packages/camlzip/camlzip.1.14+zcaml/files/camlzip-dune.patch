diff -ruN a/META.zip b/META.zip
--- a/META.zip	1970-01-01 05:30:00.000000000 +0530
+++ b/META.zip	2026-11-08 06:00:00.000000000 +0530
@@ -0,0 +1,3 @@
+version = "1.14"
+requires = "camlzip"
+directory = "../camlzip"
diff -ruN a/dune b/dune
--- a/dune	1970-01-01 05:30:00.000000000 +0530
+++ b/dune	2026-11-08 06:00:00.000000000 +0530
@@ -0,0 +1,17 @@
+(library
+ (name zip)
+ (public_name camlzip)
+ (wrapped false)
+ (modules zlib zip gzip)
+ (libraries unix libz)
+ (foreign_stubs
+  (language c)
+  (names zlibstubs)))
+
+; Upstream's findlib name, as an alias in the camlzip directory: configure
+; scripts (why3's) query zip and look for zip.cmi where it points.
+(install
+ (package camlzip)
+ (section lib_root)
+ (files
+  (META.zip as zip/META)))
diff -ruN a/dune-project b/dune-project
--- a/dune-project	1970-01-01 05:30:00.000000000 +0530
