dev-repo: "git+https://github.com/ocaml/ocamlbuild.git"
synopsis:
  "OCamlbuild is a build system with builtin rules to easily build most OCaml projects"
description: """
Built with dune: upstream's configure.make and make wrote ocamlbuild_config.ml
and installed the pack with ocamlfind; the dune rules do both."""
depends: [
  "ocaml" {>= "4.08"}
  "dune" {>= "3.0"}
]
conflicts: [
  "base-ocamlbuild"
  "ocamlfind" {< "1.6.2"}
  "relocatable"
]
patches: ["ocamlbuild-dune.patch"]
build: [["dune" "build" "-p" name "-j" jobs "@install"]]
