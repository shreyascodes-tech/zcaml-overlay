diff -ruN a/build/amd64/dune b/build/amd64/dune
--- a/build/amd64/dune	1970-01-01 05:30:00.000000000 +0530
+++ b/build/amd64/dune	2026-11-11 08:16:21.389687880 +0530
@@ -0,0 +1,97 @@
+; x86-64: configure's TARGETDIR=x86, TARGET=X86_64 (X86_WIN64 on Windows).
+; Unix has both backends and both assembly files; Windows the win64 one.
+(copy_files ../../src/*.c)
+(copy_files ../../src/x86/*.c)
+(copy_files ../../src/x86/*.S)
+(copy_files ../../src/x86/*.h)
+(copy_files ../../include/*.h)
+(copy_files ../../ffi.h)
+(copy_files ../../fficonfig.h)
+
+(foreign_library
+ (archive_name ffi_stubs)
+ (language c)
+ (extra_deps dlmalloc.c)
+ (names prep_cif types raw_api java_raw_api closures tramp ffi64 ffiw64)
+ (extra_objects unix64 win64)
+ (enabled_if
+  (and (= %{architecture} amd64) (or (= %{system} linux) (= %{system} macosx))))
+ (flags
+  :standard
+  -O3
+  -fexceptions
+  -fno-sanitize=undefined
+  -pthread
+  -D_FILE_OFFSET_BITS=64
+  -I.
+))
+
+(foreign_library
+ (archive_name ffi_stubs)
+ (language c)
+ (extra_deps dlmalloc.c)
+ (names prep_cif types raw_api java_raw_api closures tramp ffiw64)
+ (extra_objects win64)
+ (enabled_if
+  (and (= %{architecture} amd64) (= %{system} mingw64)))
+ (flags
+  :standard
+  -O3
+  -fexceptions
+  -fno-sanitize=undefined
+  -mms-bitfields
+  -I.
+))
+
+(rule
+ (targets unix64.o)
+ (enabled_if (and (= %{architecture} amd64) (or (= %{system} linux) (= %{system} macosx))))
+ (deps unix64.S)
+ (action
+  (run
+   %{cc}
+   -c
+   -O3
+   -fexceptions
+   -fno-sanitize=undefined
+   -pthread
+   -D_FILE_OFFSET_BITS=64
+   -I.
+   -o
+   %{targets}
+   %{dep:unix64.S})))
+
+(rule
+ (targets win64.o)
+ (enabled_if (and (= %{architecture} amd64) (or (= %{system} linux) (= %{system} macosx))))
+ (deps win64.S)
+ (action
+  (run
+   %{cc}
+   -c
+   -O3
+   -fexceptions
+   -fno-sanitize=undefined
+   -pthread
+   -D_FILE_OFFSET_BITS=64
+   -I.
+   -o
+   %{targets}
+   %{dep:win64.S})))
+
+(rule
+ (targets win64.o)
+ (enabled_if (and (= %{architecture} amd64) (= %{system} mingw64)))
+ (deps win64.S)
+ (action
+  (run
+   %{cc}
+   -c
+   -O3
+   -fexceptions
+   -fno-sanitize=undefined
+   -mms-bitfields
+   -I.
+   -o
+   %{targets}
+   %{dep:win64.S})))
