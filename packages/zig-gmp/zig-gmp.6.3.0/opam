opam-version: "2.0"
synopsis: "GMP 6.3.0's generated sources, from zig-gmp"
description: """
zig-gmp's checked-in generated C sources, headers, m4-expanded assembly and
manifest for GMP 6.3.0, installed for gmp to build from. The manifest is plain
text: it lists the sources, compiler definitions and include directories, so
neither configure, make nor m4 is needed."""
maintainer: "Shreyas Mididoddi <me@shreyascodes.tech>"
authors: ["zig-gmp contributors"]
license: ["LGPL-3.0-or-later" "GPL-2.0-or-later"]
homepage: "https://github.com/shreyassanthu77/zig-gmp"
bug-reports: "https://github.com/zcaml/zcaml/issues"
depends: [
  "ocaml"
  "dune" {>= "3.0"}
]
substs: [ "dune" "dune-project" ]
build: ["dune" "build" "-p" name "-j" jobs "@install"]
