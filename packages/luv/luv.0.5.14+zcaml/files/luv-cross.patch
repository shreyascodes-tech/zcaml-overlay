--- a/src/c/plat.h	1970-01-01 05:30:00.000000000 +0530
+++ b/src/c/plat.h	2026-11-11 08:09:34.611011955 +0530
@@ -0,0 +1,31 @@
+/* What libuv's configure puts on the command line, without configure. Every
+   libuv-*.c includes this before its source, so these come before any system
+   header. NDEBUG is what luv's configure passed to libuv; the ctypes stubs
+   below are built without it, as before. */
+#ifndef LUV_LIBUV_PLATFORM_CONFIG_H
+#define LUV_LIBUV_PLATFORM_CONFIG_H
+
+#define NDEBUG 1
+
+#define _FILE_OFFSET_BITS 64
+#define _LARGEFILE_SOURCE 1
+
+#if defined(__linux__)
+#  define _GNU_SOURCE 1
+#  define _POSIX_C_SOURCE 200112
+#endif
+
+#if defined(__APPLE__)
+#  define _DARWIN_UNLIMITED_SELECT 1
+#  define _DARWIN_USE_64_BIT_INODE 1
+#endif
+
+#if defined(_WIN32)
+#  ifndef _WIN32_WINNT
+#    define _WIN32_WINNT 0x0602
+#  endif
+#  define WIN32_LEAN_AND_MEAN 1
+#  define _CRT_DECLARE_NONSTDC_NAMES 0
+#endif
+
+#endif
