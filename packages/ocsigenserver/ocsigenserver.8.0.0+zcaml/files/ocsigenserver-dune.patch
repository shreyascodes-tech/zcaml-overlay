diff -ruN a/src/files/ocsigenserver.conf/dune b/src/files/ocsigenserver.conf/dune
--- a/src/files/ocsigenserver.conf/dune	2026-09-24 18:52:36.000000000 +0530
+++ b/src/files/ocsigenserver.conf/dune	2026-11-11 12:07:45.304626149 +0530
@@ -1,3 +1,23 @@
 (executable
  (name gen)
- (libraries str unix))
+ (modules gen options)
+ (libraries str findlib))
+
+(executable
+ (name gen_options)
+ (modules gen_options))
+
+; configure used to write options.ml.  Dune writes it from the package's
+; install paths instead.  dune pkg sets OCAMLFIND_DESTDIR to the package's
+; lib root; a plain dune build has no such setting, so fall back to
+; %{lib:ocsigenserver:META}, which is <prefix>/lib/ocsigenserver/META.
+(rule
+ (targets options.ml)
+ (action
+  (with-stdout-to
+   options.ml
+   (run
+    %{exe:gen_options.exe}
+    %{env:OCAMLFIND_DESTDIR=}
+    %{lib:ocsigenserver:META}
+    %{read:../../../VERSION}))))
