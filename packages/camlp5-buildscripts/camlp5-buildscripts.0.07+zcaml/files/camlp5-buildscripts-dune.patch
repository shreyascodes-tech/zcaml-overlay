diff -ruN a/META.camlp5-buildscripts.template b/META.camlp5-buildscripts.template
--- a/META.camlp5-buildscripts.template	1970-01-01 05:30:00.000000000 +0530
+++ b/META.camlp5-buildscripts.template	2026-11-10 11:51:59.204966361 +0530
@@ -0,0 +1,3 @@
+version = "0.07"
+description = "Camlp5 build scripts"
+requires = ""
diff -ruN a/dune-project b/dune-project
--- a/dune-project	1970-01-01 05:30:00.000000000 +0530
+++ b/dune-project	2026-11-10 11:51:59.204966361 +0530
@@ -0,0 +1,6 @@
+(lang dune 3.0)
+(name camlp5-buildscripts)
+(version 0.07)
+(package
+ (name camlp5-buildscripts)
+ (synopsis "Camlp5 build scripts (written in OCaml)"))
diff -ruN a/src/dune b/src/dune
--- a/src/dune	1970-01-01 05:30:00.000000000 +0530
+++ b/src/dune	2026-11-10 11:51:59.203231535 +0530
@@ -0,0 +1,47 @@
+; The four build scripts, installed in the package's library directory as
+; upstream does (they are run with `ocamlfind camlp5-buildscripts/<name>',
+; not from bin/).  Both the plain and the .exe names are installed so the
+; same package works on Unix and Windows.
+(executable
+ (name LAUNCH)
+ (modules LAUNCH)
+ (libraries re fmt unix bos rresult)
+ (link_flags -linkall))
+
+(executable
+ (name fixin)
+ (modules fixin)
+ (libraries re fmt unix bos rresult)
+ (link_flags -linkall))
+
+(executable
+ (name join_meta)
+ (modules join_meta)
+ (libraries re fmt unix bos rresult)
+ (link_flags -linkall))
+
+(executable
+ (name ya_wrap_ocamlfind)
+ (modules ya_wrap_ocamlfind)
+ (libraries re fmt unix bos rresult)
+ (link_flags -linkall))
+
+(rule (targets LAUNCH) (action (copy LAUNCH.exe %{targets})))
+(rule (targets fixin) (action (copy fixin.exe %{targets})))
+(rule (targets join_meta) (action (copy join_meta.exe %{targets})))
+(rule (targets ya-wrap-ocamlfind) (action (copy ya_wrap_ocamlfind.exe %{targets})))
+(rule (targets ya-wrap-ocamlfind.exe) (action (copy ya_wrap_ocamlfind.exe %{targets})))
+
+(install
+ (package camlp5-buildscripts)
+ (section lib)
+ (files
+  LAUNCH
+  LAUNCH.exe
+  LAUNCH.PL
+  fixin
+  fixin.exe
+  join_meta
+  join_meta.exe
+  ya-wrap-ocamlfind
+  ya-wrap-ocamlfind.exe))
