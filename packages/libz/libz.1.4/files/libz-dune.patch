diff -ruN a/dune b/dune
--- a/dune	1970-01-01 05:30:00.000000000 +0530
+++ b/dune	2026-11-08 06:00:00.000000000 +0530
@@ -0,0 +1,26 @@
+; zlib, as a library with no modules: depending on it compiles C stubs
+; with its headers and links it.
+(library
+ (name libz)
+ (public_name libz)
+ (modules)
+ (foreign_stubs
+  (language c)
+  (names
+   adler32
+   compress
+   crc32
+   deflate
+   gzclose
+   gzlib
+   gzread
+   gzwrite
+   infback
+   inffast
+   inflate
+   inftrees
+   trees
+   uncompr
+   zutil)
+  (flags :standard -DHAVE_UNISTD_H=1 -DHAVE_STDARG_H=1))
+ (install_c_headers zlib zconf))
diff -ruN a/dune-project b/dune-project
--- a/dune-project	1970-01-01 05:30:00.000000000 +0530
+++ b/dune-project	2026-11-08 06:00:00.000000000 +0530
@@ -0,0 +1,3 @@
+(lang dune 3.0)
+(name libz)
+(package (name libz) (allow_empty))
