opam-version: "2.0"
synopsis: "OpenSSL, from libopenssl, for packages built with pkg-config"
description: """
The OpenSSL that libopenssl builds, found by dune-configurator with the
toolchain's pkg-config. Unlike conf-libssl, which needs an OpenSSL installed on
the system, it cross-compiles: pkg-config searches OCAMLPATH, so it finds
libopenssl's openssl.pc in the same dune package build."""
maintainer: "Shreyas Mididoddi <me@shreyascodes.tech>"
authors: ["The OpenSSL Project"]
license: "Apache-2.0"
homepage: "https://www.openssl.org/"
bug-reports: "https://github.com/zcaml/zcaml/issues"
depends: [
  "libopenssl"
]
setenv: [
  [ PKG_CONFIG = "pkg-config" ]
]
build: []
flags: conf
